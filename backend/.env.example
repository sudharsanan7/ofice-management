# Environment
NODE_ENV=development
PORT=5000

# Client Application URL
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/officeflow

# Use unique random values of at least 32 characters in production.
JWT_SECRET=your_jwt_secret_key_min_32_characters_placeholder
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_characters_placeholder
JWT_REFRESH_EXPIRES_IN=7d

# Optional: seed a first administrator on startup. Leave blank to use /api/auth/setup-admin once.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional separate test database
MONGO_URI_TEST=mongodb://localhost:27017/officeflow_test

# SMTP / Email Configuration (quotation and account emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=placeholder
SMTP_PASS=placeholder
SMTP_FROM=noreply@officeflow.local
