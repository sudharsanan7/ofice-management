# Environment
NODE_ENV=development
PORT=5000

# Client Application URL
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/officeflow

# JWT Secrets (for future auth module)
JWT_SECRET=your_jwt_secret_key_min_32_characters_placeholder
JWT_EXPIRES_IN=7d

# SMTP / Email Configuration (for future email module)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder
SMTP_PASS=placeholder
SMTP_FROM=noreply@officeflow.local
